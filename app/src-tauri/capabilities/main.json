{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The manager window: its own daemon commands plus moving, minimizing, maximizing and closing itself. Nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "allow-status",
    "allow-featured",
    "allow-gallery",
    "allow-wallpaper",
    "allow-displays",
    "allow-apply",
    "allow-save-preset",
    "allow-install-request",
    "allow-install",
    "allow-performance",
    "allow-set-preset",
    "allow-set-pause-rule",
    "allow-set-perf-settings",
    "allow-set-app-rule",
    "allow-identify-displays",
    "allow-pause-all",
    "allow-creator-project",
    "allow-declare-origin",
    "allow-pack-and-sign",
    "allow-creator-action",
    "allow-funding",
    "allow-settings",
    "allow-update-settings",
    "allow-open-link"
  ]
}
